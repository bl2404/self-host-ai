{
    "pod_startup_script_url": "https://raw.githubusercontent.com/bl2404/self-host-ai/f55109e80e14814f94797d2c834e4a628c2acce9/runpod/pod-startup.sh",
    "pod": {
        "name": "my-first-pod",
        "computeType": "GPU",
        "cloudType": "COMMUNITY",
        "gpuCount": 1,
        "imageName": "runpod/pytorch:1.0.2-cu1281-torch280-ubuntu2404",
        "containerDiskInGb": 30,
        "env": {
            "OLLAMA_MODEL": "qwen3-coder:30b",
            "OLLAMA_HOST": "127.0.0.1:11434",
            "OLLAMA_MODELS": "/workspace/ollama",
            "OLLAMA_KEEP_ALIVE": "-1"
        },
        "ports": [
            "8888/http",
            "22/tcp"
        ]
    },
    "gpu_preferences": {
        "min_vram": 32,
        "max_price": 1.0,
        "cloud": "COMMUNITY",
        "count": 1
    }
}